{
  "id": "./",
  "name": "Ply — thread your next move",
  "short_name": "Ply",
  "description": "A goal tracker built on one claim: goals fail because they quietly stop having a next move.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#0e1014",
  "theme_color": "#0e1014",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Weekly check-in", "short_name": "Check-in", "url": "./?go=checkin",
      "description": "Walk the review queue" },
    { "name": "Capture something", "short_name": "Capture", "url": "./?go=capture",
      "description": "Put a goal or task in without choosing where it goes" }
  ]
}
